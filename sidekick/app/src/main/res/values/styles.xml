<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="face">#FFD4D0C8</color>
    <color name="title">#FF0A246A</color>
    <color name="aimYellow">#FFFFCC00</color>
    <color name="mine">#FFD6E4FF</color>
    <color name="theirs">#FFF4F4F4</color>
    <color name="myName">#FFC00000</color>
    <color name="theirName">#FF0000C0</color>

    <style name="Aim" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/face</item>
    </style>

    <style name="TitleBar">
        <item name="android:layout_width">fill_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@color/title</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:padding">6dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>
</resources>
